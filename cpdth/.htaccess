RewriteEngine On

# Redirect external GET requests for .php files to extensionless URLs
RewriteCond %{REQUEST_METHOD} GET
RewriteCond %{REQUEST_FILENAME} ^(.*)\.php$
RewriteCond %1 !-d
RewriteCond %{THE_REQUEST} ^GET\s+(.+)\.php [NC]
RewriteRule ^ %1 [R=301,L]

# Internal routing: if the requested file/directory doesn't exist, append .php
RewriteCond %{REQUEST_FILENAME} !-d 
RewriteCond %{REQUEST_FILENAME} !-f 
RewriteRule (.*) $1.php [L]
