# ==========================================
# Application Configuration
# ==========================================
APP_ENV=local
APP_NAME="CPDTH Backoffice"
APP_URL=http://localhost/am/backoffice

# ==========================================
# Database Configuration (MySQL / MariaDB)
# ==========================================
# Local XAMPP
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=bigdemo_cpa
DB_USER=root
DB_PASS=

# Server / Production Example:
# DB_HOST=103.86.48.64
# DB_PORT=3306
# DB_NAME=bigdemo_cpa
# DB_USER=bigdemo_cpau
# DB_PASS=your_password

# ==========================================
# Security & Authentication
# ==========================================
JWT_SECRET=O4525PgGnPnQ5zkWGA3JTpWGoMrdOoRu

# ==========================================
# File Storage Driver (local | s3)
# ==========================================
# local: บันทึกไฟล์ลงโฟลเดอร์ backoffice/upload ในเครื่อง
# s3: บันทึกไฟล์ขึ้น AWS S3
STORAGE_DRIVER=local
STORAGE_URL=http://localhost/am/backoffice/upload

# AWS S3 Configuration (ใช้เมื่อ STORAGE_DRIVER=s3)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-southeast-2
AWS_BUCKET=cpdth-storage
AWS_URL=https://cpdth-storage.s3.ap-southeast-2.amazonaws.com

# ==========================================
# Vimeo API Configuration
# ==========================================
VIMEO_CLIENT_ID=
VIMEO_CLIENT_SECRET=
VIMEO_ACCESS_TOKEN=
# โดเมนที่อนุญาตให้ฝังวิดีโอ (embed-only) — คั่นด้วย comma. เว้นว่างสำหรับ Local Dev
VIMEO_EMBED_DOMAINS=

# ==========================================
# Mail SMTP Configuration
# ==========================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SECURE=ssl
MAIL_FROM_ADDRESS=noreply@example.com
MAIL_FROM_NAME="CPDTH"

# แจ้งเตือนบัตรประชาชนหมดอายุอัตโนมัติ (true บน production, false บน local)
IDCARD_NOTIFY_ENABLED=false

# ==========================================
# SMS / OTP Configuration (ThaiBulkSMS)
# ==========================================
THAIBULK_KEY=
THAIBULK_SECRET=
OTP_TOKEN=
OTP_SECRET=

# ==========================================
# Web Push Notifications (VAPID)
# ==========================================
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
